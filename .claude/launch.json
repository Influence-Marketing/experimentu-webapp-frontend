{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "next-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start"],
      "port": 3000
    },
    {
      "name": "statamic-api",
      "runtimeExecutable": "php",
      "runtimeArgs": [
        "../experimentu-webapp-backend/artisan",
        "serve",
        "--host=127.0.0.1",
        "--port=8010"
      ],
      "port": 8010,
      "url": "http://127.0.0.1:8010"
    }
  ]
}
