# Statamic backend ({{base_url}} in the API list). Used server-side for GETs and in the browser for the lead form POST.
# For a local backend (php artisan serve --port=8010) use http://127.0.0.1:8010/ instead.
NEXT_PUBLIC_API_BASE_URL=https://experimentu-webapp-backend-vhg0puhq.on-forge.com/

# Google reCAPTCHA v2 site key for the lead form's robot check. Leave empty to use the built-in
# letters-and-digits check instead. Use a real key registered for your domains in production, with
# its secret as RECAPTCHA_SECRET_KEY on the backend. Google's always-pass test key (shows a
# "testing only" warning): 6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
